{
  "name": "@withseamless/node",
  "version": "1.0.0",
  "description": "Official Node.js SDK for the Seamless Partner API.",
  "homepage": "https://docs.withseamless.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esimpleai/seamless-node.git"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "node --test tests/",
    "lint:openapi": "echo 'spec lives at ../api-withseamless/openapi.yaml; lint there'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "esim",
    "seamless",
    "withseamless",
    "travel",
    "sdk",
    "partner-api"
  ],
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
